# Supabaseプロジェクト作成後、Project Settings > API から取得して
# .env.local にコピーする（.env.local はgit管理対象外）。

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# drizzle-kit generate（将来のスキーマ変更のマイグレーション生成）でのみ使用。
# Project Settings > Database > Connection string (URI, Transaction pooler推奨)
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:password@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres
